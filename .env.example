# Supabase Configuration
# Get these values from your Supabase project settings (Settings → API)

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Optional: Google OAuth (if you want to add social login)
# VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Optional: Analytics
# VITE_GA_MEASUREMENT_ID=your_ga_id_here

# Public site URL used in links inside admin emails (default https://www.turonmun.com)
# VITE_SITE_URL=https://www.turonmun.com
